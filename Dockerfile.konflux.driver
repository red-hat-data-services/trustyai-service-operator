FROM registry.redhat.io/ubi9/go-toolset:1.26@sha256:6f246e8913d082df463b62a74c72f0d2b410583e1b2ac48add39cd7ede59ce62 as builder

WORKDIR /go/src/github.com/trustyai-explainability/trustyai-service-operator
# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum
# cache deps before building and copying source so that we don't need to re-download as much
# and so that source changes don't invalidate our downloaded layer
RUN go mod download
# Copy the go source
COPY cmd/ cmd/
COPY api/ api/
COPY controllers/ controllers/

# Copy license
COPY LICENSE /licenses/ta-lmes-driver.md

USER root
RUN GO111MODULE=on CGO_ENABLED=1 GOOS=linux GOEXPERIMENT=strictfipsruntime \
    go build -tags 'strictfipsruntime netgo' -o /bin/driver ./cmd/lmes_driver/*.go

FROM registry.redhat.io/ubi9-minimal:latest@sha256:5ed244b62bbf4095080144d9d35eb8fcd3d39a9801f94aadd63b9d10978a01ae

COPY --from=builder /bin/driver /bin/driver

USER 65532:65532

WORKDIR /bin

ENTRYPOINT [ "/bin/driver" ]

LABEL name="rhoai/odh-ta-lmes-driver-rhel9" \
      com.redhat.component="odh-ta-lmes-driver-rhel9" \
      io.k8s.display-name="odh-ta-lmes-driver-rhel9" \
      io.k8s.description="Kubernetes-native execution engine that coordinates language model evaluation jobs using frameworks such as lm-evaluation-harness and Unitxt, supporting evaluation tasks with automatic device detection and progress monitoring." \
      description="Kubernetes-native execution engine that coordinates language model evaluation jobs using frameworks such as lm-evaluation-harness and Unitxt, supporting evaluation tasks with automatic device detection and progress monitoring." \
      summary="Kubernetes-native execution engine that coordinates language model evaluation jobs" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf"
